          {
            "matcher": { "id": "byName", "options": "p95 Latency" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FBBF24", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99 Tail Latency" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#EF4444", "mode": "fixed" } }]
