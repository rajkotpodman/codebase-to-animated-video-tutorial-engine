          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(fastapi_video_jobs_total) by (status)",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
