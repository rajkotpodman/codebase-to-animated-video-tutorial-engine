  "components": {
    "schemas": {
      "BillingHistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "repo_name": {
            "type": "string",
            "title": "Repo Name"
          },
          "timestamp": {
            "type": "string",
