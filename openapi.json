          },
          "resolution": {
            "type": "string",
            "title": "Resolution"
          },
          "cost_credits": {
            "type": "integer",
            "title": "Cost Credits"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id",
          "repo_name",
          "timestamp",
          "duration_seconds",
          "resolution",
          "cost_credits",
          "cost_usd",
          "status"
        ],
        "title": "BillingHistoryItem"
      },
      "CheckoutSessionResponse": {
        "properties": {
          "checkout_url": {
            "type": "string",
            "title": "Checkout Url"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "package_name": {
            "type": "string",
            "title": "Package Name"
          },
          "credits": {
            "type": "integer",
            "title": "Credits"
          },
          "amount_usd": {
            "type": "number",
            "title": "Amount Usd"
          }
        },
        "type": "object",
        "required": [
          "checkout_url",
          "session_id",
          "package_name",
          "credits",
          "amount_usd"
        ],
        "title": "CheckoutSessionResponse"
      },
      "CreateCheckoutSessionRequest": {
        "properties": {
          "package_id": {
            "type": "string",
            "title": "Package Id",
            "description": "Catalog identifier for desired package ('single_tutorial', 'starter_10', 'pro_50', 'studio_200')",
            "default": "pro_50",
            "examples": [
              "single_tutorial",
              "pro_50"
            ]
          }
        },
        "type": "object",
        "title": "CreateCheckoutSessionRequest"
      },
      "GenerateVideoRequest": {
        "properties": {
          "repo_url": {
            "type": "string",
            "title": "Repo Url",
            "description": "Public GitHub repository URL (e.g. 'https://github.com/octocat/Hello-World')",
            "examples": [
              "https://github.com/octocat/Hello-World",
              "yamadashy/repomix"
            ]
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "description": "Neural TTS voice model (e.g. 'en-US-ChristopherNeural', 'en-US-GuyNeural', 'en-US-JennyNeural')",
            "default": "en-US-ChristopherNeural"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "1080p",
              "720p",
              "480p"
            ],
            "title": "Resolution",
            "description": "Target output video resolution",
            "default": "1080p"
          },
          "theme": {
            "type": "string",
            "enum": [
              "midnight",
              "dark",
              "cyberpunk",
              "nord"
            ],
            "title": "Theme",
            "description": "Manim architecture diagram styling theme",
            "default": "midnight"
          },
          "burn_subtitles": {
            "type": "boolean",
            "title": "Burn Subtitles",
            "description": "Whether to burn synchronized subtitles directly into the video stream",
            "default": true
          },
          "custom_instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Instructions",
            "description": "Optional custom focus prompt for Gemini script generation (e.g. 'Focus on auth & caching')"
          },
          "run_sync": {
            "type": "boolean",
            "title": "Run Sync",
            "description": "If True, runs synchronously in-process (useful for local debugging or non-Celery environments)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "repo_url"
        ],
        "title": "GenerateVideoRequest",
        "description": "Payload for initiating tutorial video generation."
      },
      "GenerateVideoResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "status_url",
          "message"
        ],
        "title": "GenerateVideoResponse",
        "description": "Immediate response confirming task enqueue."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "step": {
