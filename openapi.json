        "summary": "Stripe Webhook Listener for asynchronous payment fulfillment",
        "description": "Receives and verifies Stripe webhook events, automatically provisioning credits in PostgreSQL.",
        "operationId": "stripe_webhook_api_v1_billing_webhook_post",
        "parameters": [
          {
            "name": "stripe-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
