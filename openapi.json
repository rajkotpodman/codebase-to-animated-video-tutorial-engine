{
  "openapi": "3.1.0",
  "info": {
    "title": "Codebase-to-Animated Video Tutorial Engine",
    "description": "Automated end-to-end backend service that converts public GitHub codebases into animated tutorial videos.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/generate-video": {
      "post": {
        "tags": [
          "Video Generation Pipeline"
        ],
        "summary": "Trigger asynchronous codebase tutorial video generation",
        "description": "Triggers the 5-stage background video generation pipeline:\n\n1. Ingestion / Repomix codebase packaging\n2. Gemini AI architecture topology & script generation\n3. Manim Community animation rendering\n4. Neural voiceover TTS & .srt subtitle synthesis\n5. FFmpeg final resolution scaling, duration sync, & subtitle burn-in",
        "operationId": "generate_video_api_v1_generate_video_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateVideoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateVideoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "Video Generation Pipeline"
        ],
        "summary": "Query background task status and progress",
        "description": "Poll the status and progress of a video generation task with short-lived caching.",
        "operationId": "get_job_status_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/stream": {
      "get": {
        "tags": [
          "Video Generation Pipeline"
        ],
        "summary": "Stream live video generation progress via Server-Sent Events (SSE)",
        "description": "Stream live progress updates (0% to 100% and stage changes) directly via Server-Sent Events.",
        "operationId": "stream_job_progress_api_v1_jobs__job_id__stream_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/download": {
      "get": {
        "tags": [
          "Video Generation Pipeline"
        ],
        "summary": "Download the final rendered MP4 tutorial video",
        "description": "Stream or download the final synthesized HD tutorial video.",
        "operationId": "download_video_api_v1_jobs__job_id__download_get",
        "parameters": [
          {
            "name": "job_id",
