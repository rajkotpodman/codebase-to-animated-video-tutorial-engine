# =============================================================================
# Codebase-to-Animated Video Tutorial Engine
# Environment Configuration Template
# =============================================================================

# --- General & Network Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=codevideo
POSTGRES_PASSWORD=codevideo_secret_password_change_in_production
POSTGRES_DB=codevideo_db
DATABASE_URL=postgresql://codevideo:codevideo_secret_password_change_in_production@postgres:5432/codevideo_db

# --- Task Queue & Cache (Redis & Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Google Gemini AI API ---
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Cloud Storage (AWS S3 / Cloudflare R2 / MinIO) ---
AWS_S3_BUCKET=codevideo-tutorials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Optional for S3-compatible providers (e.g. MinIO, Cloudflare R2):
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- Supabase Authentication ---
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
AUTH_REQUIRED=false

# --- Stripe SaaS Billing Gateway ---
# Obtain from Stripe Dashboard (Developers -> API keys & Webhooks)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

